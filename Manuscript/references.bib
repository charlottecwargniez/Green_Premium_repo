@article{bruegge_does_2016,
	title = {Does the housing market value energy efficient homes? Evidence from the energy star program},
	volume = {57},
	issn = {0166-0462},
	url = {https://www.sciencedirect.com/science/article/pii/S016604621500109X},
	doi = {10.1016/j.regsciurbeco.2015.12.001},
	shorttitle = {Does the housing market value energy efficient homes?},
	abstract = {The “Energy Star” certification of residential homes is a recent attempt in the United States to improve energy efficiency in the residential sector by incentivizing home builders to “build green.” We examine the effectiveness of this program by estimating homeowners' marginal willingness to pay for Energy Star residences in Gainesville, Florida. We use single-family residential property sales in Gainesville, Florida between 1997 and 2009. Using the hedonic method, we find that homeowners are willing to pay a premium for new Energy Star homes, but that this premium fades rapidly in the resale market.},
	pages = {63--76},
	journaltitle = {Regional Science and Urban Economics},
	shortjournal = {Regional Science and Urban Economics},
	author = {Bruegge, Chris and Carrión-Flores, Carmen and Pope, Jaren C.},
