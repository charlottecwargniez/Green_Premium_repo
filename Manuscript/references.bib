@article{hope_attitudes_2014,
	title = {Attitudes and behaviours of private sector landlords towards the energy efficiency of tenanted homes},
	volume = {75},
	issn = {0301-4215, 1873-6777},
	url = {https://www.webofscience.com/api/gateway?GWVersion=2&SrcAuth=DOISource&SrcApp=UA&KeyAID=10.1016%2Fj.enpol.2014.09.018&DestApp=DOI&SrcAppSID=EUW1ED0E4FNvsPPp5gfuReVuCuxlZ&SrcJTitle=ENERGY+POLICY&DestDOIRegistrantName=Elsevier},
	doi = {10.1016/j.enpol.2014.09.018},
	abstract = {The {UK}'s housing stock generates approximately 27\% of the country's total annual carbon emissions. In light of the legally binding targets to reduce carbon emissions, new housing is subject to a tightening of regulations governing energy demand and efficiency resulting in a gradual improvement in carbon emissions. The question is how to achieve the deep carbon emission reductions from existing domestic properties, of which 75\% will still be in use in 2050. Government has sought to provide incentives to homeowners to improve the energy efficiency of their households, and mandate improvements in socially rented housing using a range of fiscal measures, most recently the 'Green Deal'. There has however been little consideration of the 18\% of {UK} households who privately rent their home, a tenure that is growing fast. The aim of this research is to investigate the factors that influence private sector landlords when considering energy efficiency improvements to their tenanted homes. The results indicate that government policy has consistently failed to engage private sector landlords in the issue of energy efficiency and thus measures must be taken to understand the motivations of landlords in order to design effective incentives and interventions. (C) 2014 Elsevier Ltd. All rights reserved.},
	pages = {369--378},
	journaltitle = {{ENERGY} {POLICY}},
	shortjournal = {Energy Policy},
	author = {Hope, Alexander John and Booth, Alexander},
	urldate = {2024-08-23},
	date = {2014-12},
	note = {Num Pages: 10
Place: Oxford
Publisher: Elsevier Sci Ltd
Web of Science {ID}: {WOS}:000347604500038},
	keywords = {Energy efficiency, Housing, Energy policy, {POLICY}, {BARRIERS}, {CLIMATE}-{CHANGE}, {ENGLAND}, {EXISTING} {BUILDINGS}, Green Deal, Rented sector, {UK}},
	file = {Accepted Version:/Users/wargniez/Zotero/storage/8EPHLUV8/Hope and Booth - 2014 - Attitudes and behaviours of private sector landlor.pdf:application/pdf},
}

