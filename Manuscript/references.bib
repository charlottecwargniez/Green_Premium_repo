@article{de_cian_households_2019,
	title = {Households’ adaptation in a warming climate. Air conditioning and thermal insulation choices},
	volume = {100},
	rights = {cc\_by\_nc\_nd},
	issn = {1462-9011},
	url = {https://researchonline.lshtm.ac.uk/id/eprint/4661907/?utm_source=chatgpt.com},
	abstract = {Adjustments in the final use of energy are a critical margin of adaptation for maintaining indoor thermal comfort. This paper explores how households have been adopting air conditioning and thermal insulation to cope with different climatic conditions, and how climatic factors interact with socio-economic, demographic, and household characteristics across eight {OECD} countries. Changes in the cumulative number of hot and cold days over the year, urbanization, demographics and household characteristics, including attitudes towards energy efficiency, strongly affect those two margins of adaptation, along with income. If the historically-observed adaptation behaviour is maintained also under future socio-economic pathways and climate scenarios, the impact of global warming and income on air conditioning adoption will be reinforced by urbanization trends, which on the contrary will make it more difficult to improve building thermal insulation.},
	pages = {136--157},
	journaltitle = {Environmental Science \& Policy},
	author = {De Cian, Enrica and Pavanello, Filippo and Randazzo, Teresa and Mistry, Malcolm N. and Davide, Marinella},
	urldate = {2025-03-26},
	date = {2019-10-01},
	langid = {english},
	note = {Publisher: Elsevier},
	file = {Full Text PDF:/Users/wargniez/Zotero/storage/GSBAD9LN/De Cian et al. - 2019 - Households’ adaptation in a warming climate. Air conditioning and thermal insulation choices.pdf:application/pdf;Snapshot:/Users/wargniez/Zotero/storage/Y4TWQX4C/4661907.html:text/html},
}

@book{joint_research_centre________________________________________european_commission_building_2020,
	title = {Building energy renovation for decarbonisation and Covid-19 recovery: a snapshot at regional level},
	isbn = {978-92-76-24766-1},
	url = {https://data.europa.eu/doi/10.2760/08629},
	shorttitle = {Building energy renovation for decarbonisation and Covid-19 recovery},
	abstract = {Our society and economy are changing as our lifestyles shift in a world recovering from Covid-19. While the governments are working to face this challenge, new local and regional instances stand out. A sustainable recovery throughout Europe calls for a reduction of the existing gaps between regions. Energy efficiency qualifies as one of the sectors with a greater potential for the double dividend hypothesis, thus supporting economic recovery and decarbonisation simultaneously. Although recent years have witnessed the introduction of various regulatory mechanisms and incentives for efficiency, the energy saving potential of the European building stock is still very high, especially in the residential sector. To activate it, a thirty-year planning and short-term shock measures are required to unlock the efficiency process. This report provides a snapshot of the European building stock at local level, and identifies the most critical regions, taking into account buildings age, climatic conditions, some structural barriers and key economic indicators. Based on this information, we calculated the energy saving potential of extensive renovation of residential buildings, as well as the associated investment needs and the impact on employment. These indications and datasets can guide decision-makers in the definition of fine-tuned programmes for the refurbishment of existing buildings at European and national level.},
	publisher = {Publications Office of the European Union},
	author = {{Joint Research Centre
                
                        (European Commission)} and Zangheri, P. and Armani, R. and Kakoulaki, G. and Bavetta, M. and Martirano, G. and Pignatelli, F. and Baranzelli, C.},
	urldate = {2025-03-26},
	date = {2020},
	keywords = {energy efficiency, energy saving, Energy, building industry, carbon capture and storage, coronavirus disease, economic recovery, {EU} regional policy, improvement of housing, investment, report, sustainable development},
	file = {Full Text PDF (en):/Users/wargniez/Zotero/storage/2HHZEP87/Joint Research Centre                                          (European Commission) et al. - 2020 - Building energy renovation for decarbonisation and Covid-19 recovery a snapshot at regional level.pdf:application/pdf},
}

