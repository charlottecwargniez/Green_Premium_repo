@article{ferrell_cultural_1999,
	title = {{CULTURAL} {CRIMINOLOGY}},
	volume = {25},
	issn = {0360-0572, 1545-2115},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev.soc.25.1.395},
	doi = {10.1146/annurev.soc.25.1.395},
	abstract = {▪ Abstract As an emergent orientation in sociology, criminology, and criminal justice, cultural criminology explores the convergence of cultural and criminal processes in contemporary social life. Drawing on perspectives from cultural studies, postmodern theory, critical theory, and interactionist sociology, and on ethnographic methodologies and media/textual analysis, this orientation highlights issues of image, meaning, and representation in the interplay of crime and crime control. Specifically, cultural criminology investigates the stylized frameworks and experiential dynamics of illicit subcultures; the symbolic criminalization of popular culture forms; and the mediated construction of crime and crime control issues. In addition, emerging areas of inquiry within cultural criminology include the development of situated media and situated audiences for crime; the media and culture of policing; the links between crime, crime control, and cultural space; and the collectively embodied emotions that shape the meaning of crime.},
	pages = {395--418},
	issue = {Volume 25, 1999},
	journaltitle = {Annual Review of Sociology},
	author = {Ferrell, Jeff},
	urldate = {2025-04-28},
	date = {1999-08-01},
	langid = {english},
	note = {Publisher: Annual Reviews},
	file = {Snapshot:/Users/wargniez/Zotero/storage/98CC74RA/annurev.soc.25.1.html:text/html},
}
